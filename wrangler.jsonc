{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designpool",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "designpool"
    }
  ],
  // Daily ingest in three parts an hour apart, same schedule the Vercel crons used.
  // cloudflare/worker.ts maps each schedule to /api/cron?part=N&parts=3.
  "triggers": {
    "crons": ["15 8 * * *", "15 9 * * *", "15 10 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "INGEST_SOURCES": "greenhouse,ashby,lever",
    "LLM_CLASSIFIER_ENABLED": "false"
  }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   DATABASE_URL  Neon connection string
  //   CRON_SECRET   bearer token for /api/cron
  //   LLM_API_URL, LLM_API_KEY, LLM_MODEL  only if LLM_CLASSIFIER_ENABLED is "true"
}
