# Postgres connection string (Neon, or any Postgres). Leave unset locally to use SQLite.
# On Vercel, leave this unset until Neon is connected. The site still builds and shows an empty state.
DATABASE_URL=

# Canonical URL for metadata, the sitemap, and Open Graph.
# Defaults to https://designpool-taupe.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://designpool-taupe.vercel.app

# Required for the daily cron route. Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional seniority refinement for ambiguous "Lead" titles. Off by default.
LLM_CLASSIFIER_ENABLED=false
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
