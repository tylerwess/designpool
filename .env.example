# Postgres connection string (Neon, or any Postgres). Leave unset locally to use SQLite.
# On Cloudflare this is a Worker secret: npx wrangler secret put DATABASE_URL
DATABASE_URL=

# Canonical URL for metadata, the sitemap, and Open Graph.
# Defaults to https://designpool.io when unset. Read at build time.
# NEXT_PUBLIC_SITE_URL=https://designpool.io

# Bearer token for /api/cron. On Cloudflare this is a Worker secret: npx wrangler secret put CRON_SECRET
# Until it is set every request to that route returns 401 and the scheduled ingest skips.
CRON_SECRET=

# Boards to fetch on ingest. Comma-separated: greenhouse, ashby, lever.
# Unset means all three. Set INGEST_SOURCES=greenhouse to narrow a run
# back down to Greenhouse only.
# INGEST_SOURCES=greenhouse,ashby,lever

# Optional seniority refinement for ambiguous "Lead" titles. Off by default.
LLM_CLASSIFIER_ENABLED=false
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
